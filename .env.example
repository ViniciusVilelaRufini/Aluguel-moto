NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://volti:volti@localhost:5432/volti
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=volti
S3_SECRET_KEY=volti-dev-secret
S3_BUCKET_KYC=documentos-kyc
S3_BUCKET_RETURN_PHOTOS=fotos-devolucao
S3_BUCKET_REPORTS=relatorios
AUTH_MODE=dev
DEV_JWT_SECRET=troque-este-segredo-local
IOT_MODE=local
GEOFENCE_MODE=local
QUEUE_MODE=local
STORAGE_MODE=local
PAYMENT_PROVIDER=fake
INSURANCE_PROVIDER=mock
KYC_PROVIDER=mock
PUSH_MODE=log
TRACK_RETENTION_DAYS=90
OUT_OF_AREA_LOCK_MINUTES=5
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── API (Task 3) ──
APP_VERSION=0.1.0
LOG_LEVEL=info
JOBS_ENABLED=true
RESERVATION_TTL_SECONDS=900
THROTTLE_LIMIT_PER_MINUTE=300
# CORS (QA-10): origens do painel separadas por vírgula; vazio = só localhost fora de produção, nenhuma em produção
CORS_ORIGINS=
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET_ATTACHMENTS=anexos
AWS_REGION=sa-east-1
PUBLIC_SHARE_BASE_URL=http://localhost:3000/share
# Pagamentos (Task 5, docs/pagamentos.md)
# Gateway fake: segundos até o Pix ser pago sozinho e entrar pela fila como webhook (0 desliga; aceita o nome antigo STUB_PIX_AUTOCONFIRM_SECONDS)
FAKE_PIX_AUTOCONFIRM_SECONDS=10
PIX_EXPIRATION_MINUTES=15
MERCADOPAGO_API_BASE_URL=
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
# Dias que uma cobrança/captura pode ficar em análise no gateway antes de a liquidação ser estacionada para revisão manual
PAYMENT_REVIEW_MAX_DAYS=7
INVOICE_ISSUER=mock
# Container: aplica migrações (e opcionalmente o seed) ao subir
RUN_MIGRATIONS=true
RUN_SEED=false
# AUTH_MODE=cognito
COGNITO_REGION=sa-east-1
COGNITO_CUSTOMER_POOL_ID=
COGNITO_STAFF_POOL_ID=
# QUEUE_MODE=sqs (LocalStack opcional em SQS_ENDPOINT)
SQS_ENDPOINT=
SQS_QUEUE_TELEMETRIA_URL=
SQS_QUEUE_PAGAMENTOS_WEBHOOK_URL=
SQS_QUEUE_ALERTAS_URL=
# ── IoT (Task 4) ──
# IOT_MODE=local|aws|stub · GEOFENCE_MODE=local|aws (acima)
IOT_CONFIRM_WAIT_MS=3000
IOT_COMMAND_TIMEOUT_MS=30000
IOT_OFFLINE_AFTER_MS=180000
# Depois de qualquer reconexão, nenhuma amostra de velocidade vale para travar neste intervalo (fila offline do MQTT esvaziada)
IOT_RECONNECT_GRACE_MS=10000
# Lacuna entre mensagens do rastreador que conta como reconexão (abre a graça acima); parada/travada: máx(isto, 150000). No aws é o único detector de quedas curtas
IOT_RECONNECT_GAP_MS=15000
# Telemetria com atraso de fila (chegada − medição, relativo à anterior) maior que isto = saiu da fila offline → reconexão
IOT_QUEUE_LAG_MS=5000
# IOT_MODE=aws: endpoint do IoT Data Plane (SSM /volti/<env>/iot/endpoint)
IOT_ENDPOINT=
IOT_SHADOW_POLL_MS=1000
# GEOFENCE_MODE=aws (padrão: volti-<VOLTI_ENV>-tracker / -geofences)
VOLTI_ENV=dev
LOCATION_TRACKER_NAME=
LOCATION_GEOFENCE_COLLECTION=
# Simulador (services/iot-sim, docker compose --profile sim)
SIM_VEHICLES=50
SIM_EVENTS=
SIM_INJECT=
