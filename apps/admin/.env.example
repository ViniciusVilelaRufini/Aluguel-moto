NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# dev | cognito
NEXT_PUBLIC_AUTH_MODE=dev
# Só no modo cognito: login com e-mail e senha (SRP) direto no pool interno
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Hosted UI: só para concluir logins antigos em /auth/callback e para o logout dessas sessões
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3100/auth/callback
