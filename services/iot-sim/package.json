{
  "name": "iot-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de rastreadores Volti: N motos virtuais via MQTT, rotas em São Paulo, obedecendo ao device shadow.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "lint": "eslint \"src/**/*.ts\" && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "mqtt": "5.10.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.18.1"
  }
}
