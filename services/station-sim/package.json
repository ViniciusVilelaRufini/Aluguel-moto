{
  "name": "station-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador das estações de troca de bateria Volti: responde aos comandos open_slot/release_battery via MQTT (modo automático ou manual pelo teclado).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts --all",
    "dev:manual": "tsx src/main.ts --manual --all",
    "lint": "eslint \"src/**/*.ts\" && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "mqtt": "5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.18.1"
  }
}
