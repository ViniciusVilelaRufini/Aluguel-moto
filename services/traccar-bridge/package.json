{
  "name": "traccar-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Ponte GT06 da Volti: Traccar (WebSocket + REST) → tópicos MQTT do contrato; inclui o emulador GT06 de testes.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "emulator": "tsx src/gt06/emulator-main.ts",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "mqtt": "5.10.1",
    "pg": "8.13.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/ws": "8.18.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.18.1"
  }
}
