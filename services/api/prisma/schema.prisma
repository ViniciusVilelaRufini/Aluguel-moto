/// Progresso da liquidação de um aluguel (fix round 1): plano decidido uma vez, passos concluídos, tentativas e lease
/// (dono + validade) para que só um executor por vez fale com o gateway.
model SettlementProgress {
  paymentId   String    @id @db.Uuid
  plan        String
  depositId   String?   @db.Uuid
  steps       Json      @default("{}")
  attempts    Int       @default(0)
  lastFailure String?
  /// Execuções que terminaram em erro/resultado ambíguo do gateway (fix round 2); no limite, a liquidação é estacionada.
  errorRuns   Int       @default(0)
  parkedAt    DateTime?
  parkedReason String?
  /// Liquidação concluída (Payment saiu de `pending`); o job de retomada só lê registros sem `finishedAt` e sem `parkedAt` (fix round 4).
  finishedAt  DateTime?
  leaseOwner  String?
  leaseUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@index([parkedAt, finishedAt, updatedAt])
}

/// Pedido de liberação de caução ainda não confirmado pelo gateway (retentado por job).
model DepositRelease {
  depositId   String    @id @db.Uuid
  reason      String
  attempts    Int       @default(0)
  lastError   String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([confirmedAt])
}

/// Valor efetivamente capturado de uma pré-autorização (teto de estorno do pagamento da caução).
model PaymentCapture {
  paymentId     String   @id @db.Uuid
  capturedCents Int
  createdAt     DateTime @default(now())
}

/// Pedido de estorno (fix round 2): reserva gravada junto com o claim do Payment; resultado do gateway reconciliado por job.
/// status: claimed (gateway ainda não chamado) | pending (resultado desconhecido) | succeeded | rejected | needs_review
model PaymentRefund {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @db.Uuid
  idempotencyKey    String   @unique
  amountCents       Int
  prevStatus        String
  prevRefundedCents Int
  newStatus         String
  newRefundedCents  Int
  status            String
  attempts          Int      @default(0)
  providerRefundId  String?
  lastError         String?
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([paymentId])
}

/// QA-21 (fix round 1): início de aluguel em andamento (moto reivindicada, desbloqueio pedido, aluguel ainda não criado).
/// Apagado quando o aluguel é criado ou compensado; o job de varredura compensa os que sobraram (processo morreu no meio).
model RentalStart {
  rentalId       String        @id @db.Uuid
  vehicleId      String        @db.Uuid
  customerId     String        @db.Uuid
  depositId      String?       @db.Uuid
  policyId       String?       @db.Uuid
  previousStatus VehicleStatus
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([customerId])
}

/// QA-07 (fix round 1): exclusão da identidade no pool de clientes pendente (falhou na hora). Guarda o `sub` só até o
/// Cognito confirmar a exclusão; o job de retentativa apaga a linha no sucesso.
model CustomerIdentityDeletion {
  customerId String   @id @db.Uuid
  sub        String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([attempts])
}

