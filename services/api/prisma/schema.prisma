// ───────────── pessoas ─────────────

model Customer {
  id                        String         @id @default(uuid()) @db.Uuid
  cognitoSub                String         @unique
  email                     String
  name                      String?
  phone                     String?
  cpf                       String?        @unique
  birthDate                 DateTime?      @db.Date
  kycStatus                 KycStatus      @default(not_started)
  kycReason                 String?
  kycSubmittedAt            DateTime?
  kycReviewedAt             DateTime?
  kycDocumentType           DocumentType?
  kycDocumentFrontKey       String?
  kycDocumentBackKey        String?
  kycSelfieKey              String?
  status                    CustomerStatus @default(active)
  delinquent                Boolean        @default(false)
  blockedReason             String?
  blockedAt                 DateTime?
  emergencyContactName      String?
  emergencyContactPhone     String?
  termsVersion              String?
  termsAccepted             Boolean        @default(false)
  termsAcceptedAt           DateTime?
  locationConsent           Boolean        @default(false)
  locationConsentUpdatedAt  DateTime?
  marketingConsent          Boolean        @default(false)
  consentsUpdatedAt         DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  reservations  Reservation[]
  rentals       Rental[]
  payments      Payment[]
  deposits      Deposit[]
  cards         PaymentCard[]
  subscriptions Subscription[]
  walletEntries WalletEntry[]
  topUps        TopUp[]
  policies      InsurancePolicy[]
  incidents     Incident[]
  disputes      Dispute[]
  claims        Claim[]
  conversations SupportConversation[]

  @@index([kycStatus])
  @@index([status])
}

model StaffUser {
  id          String       @id @default(uuid()) @db.Uuid
  cognitoSub  String?      @unique
  email       String       @unique
  name        String
  groups      StaffGroup[]
  active      Boolean      @default(true)
  mfaEnabled  Boolean      @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  fcmToken   String         @unique
  platform   DevicePlatform
  appVersion String?
  ownerType  ActorType
  ownerId    String         @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([ownerId])
}

model RestrictionEntry {
  id          String   @id @default(uuid()) @db.Uuid
  cpf         String   @unique
  reason      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
}

// ───────────── frota ─────────────

model Vehicle {
  id                  String         @id @default(uuid()) @db.Uuid
  code                String         @unique
  qrCode              String?
  model               String
  thingName           String         @unique
  status              VehicleStatus  @default(free)
  statusBeforeOffline VehicleStatus?
  lat                 Float          @default(0)
  lng                 Float          @default(0)
  batteryPct          Int            @default(100)
  speedLimitKmh       Int            @default(32)
  speedKmh            Float?
  online              Boolean        @default(true)
  locked              Boolean        @default(true)
  ignition            Boolean        @default(false)
  signal              Int?
  stolenMode          Boolean        @default(false)
  firmwareVersion     String?
  lastSeenAt          DateTime?
  batterySerial       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tracker      Tracker?
  reservations Reservation[]
  rentals      Rental[]
  commands     VehicleCommand[]
  fieldTasks   FieldTask[]
  maintenance  MaintenanceTask[]

  @@index([status])
}

model Tracker {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String?  @unique @db.Uuid
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  thingName       String   @unique
  imei            String?
  firmwareVersion String?
  certificateArn  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Battery {
  id         String   @id @default(uuid()) @db.Uuid
  serial     String   @unique
  chargePct  Int      @default(100)
  vehicleId  String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Cerca. `geom` (PostGIS) é a fonte para ST_Contains; `geometry` guarda o GeoJSON devolvido pela API.
model Zone {
  id            String                                 @id @default(uuid()) @db.Uuid
  name          String
  type          ZoneType
  speedLimitKmh Int?
  geometry      Json
  geom          Unsupported("geometry(Polygon,4326)")?
  active        Boolean                                @default(true)
  deletedAt     DateTime?
  createdAt     DateTime                               @default(now())
  updatedAt     DateTime                               @updatedAt

  @@index([type, active])
  @@index([geom], map: "Zone_geom_gist", type: Gist)
}

model VehicleCommand {
  id              String               @id @default(uuid()) @db.Uuid
  vehicleId       String               @db.Uuid
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id])
  type            CommandType
  status          CommandStatus        @default(pending)
  statusReason    CommandStatusReason?
  reason          String
  requestedById   String?              @db.Uuid
  requestedByType ActorType            @default(staff)
  requestedByName String?
  /// { speedLimitKmh?, on?, rentalId?, fieldTaskId?, purpose? }
  payload         Json                 @default("{}")
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([vehicleId, createdAt])
  @@index([status])
}

/// Ponto de trajeto (LGPD): só durante aluguel; expira em 90 dias.
model TrackPoint {
  id         String   @id @default(uuid()) @db.Uuid
  rentalId   String?  @db.Uuid
  vehicleId  String   @db.Uuid
  lat        Float
  lng        Float
  speedKmh   Float    @default(0)
  recordedAt DateTime
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([rentalId, recordedAt])
  @@index([vehicleId, recordedAt])
}

// ───────────── preços ─────────────

model PricingPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  code                PlanCode
  name                String
  description         String?
  unit                PlanUnit
  unlockFeeCents      Int      @default(0)
  unitPriceCents      Int
  pausePerMinuteCents Int      @default(0)
  recurring           Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([code, active])
}

model Coupon {
  id                        String       @id @default(uuid()) @db.Uuid
  code                      String       @unique
  description               String?
  discountType              DiscountType
  percentOff                Int?
  amountOffCents            Int?
  planCodes                 PlanCode[]
  validFrom                 DateTime?
  validUntil                DateTime?
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?
  redemptions               Int          @default(0)
  active                    Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  redemptionsLog CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customerId String   @db.Uuid
  rentalId   String   @unique @db.Uuid
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
}

model Fee {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  amountCents Int
  active      Boolean  @default(true)
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────── reserva e aluguel ─────────────

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @db.Uuid
  customer   Customer          @relation(fields: [customerId], references: [id])
  vehicleId  String            @db.Uuid
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id])
  status     ReservationStatus @default(active)
  depositId  String?           @db.Uuid
  expiresAt  DateTime
  endedAt    DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([customerId, status])
  @@index([vehicleId, status])
  @@index([status, expiresAt])
}

model Rental {
  id                     String            @id @default(uuid()) @db.Uuid
  customerId             String            @db.Uuid
  customer               Customer          @relation(fields: [customerId], references: [id])
  vehicleId              String            @db.Uuid
  vehicle                Vehicle           @relation(fields: [vehicleId], references: [id])
  planCode               PlanCode
  coverage               InsuranceCoverage
  status                 RentalStatus      @default(active)
  startedAt              DateTime          @default(now())
  pausedAt               DateTime?
  pausedSecondsAcc       Int               @default(0)
  endRequestedAt         DateTime?
  endLastAttemptAt       DateTime?
  endAttempts            Int               @default(0)
  endedAt                DateTime?
  /// Preço congelado no início: { unit, unlockFeeCents, unitPriceCents, pausePerMinuteCents, insurancePremiumCents, subscriptionCovered, coupon? }
  priceSnapshot          Json
  costCents              Int               @default(0)
  breakdown              Json?
  couponCode             String?
  depositId              String            @db.Uuid
  insurancePolicyId      String?           @db.Uuid
  paymentId              String?           @db.Uuid
  endZoneId              String?           @db.Uuid
  returnPhotoUploadKey   String?
  returnPhotoObjectKey   String?
  forceEndReason         String?
  forcedEndById          String?           @db.Uuid
  rating                 Int?
  ratingComment          String?
  speedLimitKmh          Int?
  startLat               Float?
  startLng               Float?
  wellbeingCheckDueAt    DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  events RentalEvent[]

  @@index([customerId, startedAt])
  @@index([vehicleId, startedAt])
  @@index([status])
}

model RentalEvent {
  id        String          @id @default(uuid()) @db.Uuid
  rentalId  String          @db.Uuid
  rental    Rental          @relation(fields: [rentalId], references: [id])
  type      RentalEventType
  at        DateTime        @default(now())
  actorType ActorType
  actorId   String?         @db.Uuid
  message   String?
  data      Json?

  @@index([rentalId, at])
}

model LocationShare {
  id        String   @id @default(uuid()) @db.Uuid
  rentalId  String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ───────────── pagamentos (Task 5 implementa a lógica real) ─────────────

model PaymentCard {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id])
  providerCardId  String
  brand           String
  last4           String
  expMonth        Int
  expYear         Int
  isDefault       Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([customerId])
}

model Deposit {
  id                String        @id @default(uuid()) @db.Uuid
  rentalId          String?       @db.Uuid
  customerId        String        @db.Uuid
  customer          Customer      @relation(fields: [customerId], references: [id])
  method            DepositMethod
  status            DepositStatus
  amountCents       Int
  capturedCents     Int?
  cardId            String?       @db.Uuid
  idempotencyKey    String?       @unique
  providerReference String?
  /// PixCharge { chargeId, qrCodeBase64, copyPaste, expiresAt }
  pix               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId, status])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @db.Uuid
  customer          Customer      @relation(fields: [customerId], references: [id])
  rentalId          String?       @db.Uuid
  depositId         String?       @db.Uuid
  subscriptionId    String?       @db.Uuid
  kind              PaymentKind
  method            PaymentMethod
  status            PaymentStatus
  amountCents       Int
  refundedCents     Int           @default(0)
  cardLast4         String?
  failureReason     String?
  providerPaymentId String?
  receiptUrl        String?
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([rentalId])
  @@index([status])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  customerId         String             @db.Uuid
  customer           Customer           @relation(fields: [customerId], references: [id])
  planCode           PlanCode
  status             SubscriptionStatus
  cardId             String?            @db.Uuid
  priceCents         Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId, status])
}

model MinutePackage {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  minutes    Int
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TopUp {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @db.Uuid
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      TopUpStatus
  method      DepositMethod
  amountCents Int
  packageId   String?     @db.Uuid
  minutes     Int?
  pix         Json?
  paymentId   String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Ledger somente inserção: o saldo é sempre a soma.
model WalletEntry {
  id                String          @id @default(uuid()) @db.Uuid
  customerId        String          @db.Uuid
  customer          Customer        @relation(fields: [customerId], references: [id])
  type              WalletEntryType
  amountCents       Int
  minutes           Int?
  balanceAfterCents Int
  description       String
  rentalId          String?         @db.Uuid
  paymentId         String?         @db.Uuid
  createdById       String?         @db.Uuid
  createdAt         DateTime        @default(now())

  @@index([customerId, createdAt])
}

// ───────────── seguro (Task 5 implementa a lógica real) ─────────────

model InsuranceCoverageConfig {
  coverage     InsuranceCoverage @id
  name         String
  description  String
  premiumCents Int
  mandatory    Boolean           @default(false)
  /// CoverageItem[]
  items        Json              @default("[]")
  active       Boolean           @default(true)
  updatedAt    DateTime          @updatedAt
}

model InsurancePolicy {
  id               String            @id @default(uuid()) @db.Uuid
  rentalId         String            @db.Uuid
  customerId       String            @db.Uuid
  customer         Customer          @relation(fields: [customerId], references: [id])
  coverage         InsuranceCoverage
  premiumCents     Int
  payoutCents      Int?
  status           PolicyStatus      @default(active)
  providerPolicyId String?
  issuedAt         DateTime          @default(now())
  canceledAt       DateTime?

  @@index([customerId])
  @@index([rentalId])
}

// ───────────── operação ─────────────

model Alert {
  id         String        @id @default(uuid()) @db.Uuid
  type       AlertType
  priority   AlertPriority
  status     AlertStatus   @default(open)
  vehicleId  String?       @db.Uuid
  rentalId   String?       @db.Uuid
  message    String
  lat        Float?
  lng        Float?
  assigneeId String?       @db.Uuid
  resolution String?
  createdAt  DateTime      @default(now())
  assignedAt DateTime?
  resolvedAt DateTime?

  @@index([status, priority, createdAt])
  @@index([vehicleId])
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  actorName  String?
  action     String
  entityType String
  entityId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Incident {
  id              String           @id @default(uuid()) @db.Uuid
  customerId      String?          @db.Uuid
  customer        Customer?        @relation(fields: [customerId], references: [id])
  rentalId        String?          @db.Uuid
  vehicleId       String?          @db.Uuid
  category        IncidentCategory
  status          IncidentStatus   @default(open)
  description     String
  photoObjectKeys String[]
  lat             Float?
  lng             Float?
  resolutionNote  String?
  createdById     String?          @db.Uuid
  createdByType   ActorType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId])
}

model Dispute {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @db.Uuid
  customer          Customer      @relation(fields: [customerId], references: [id])
  rentalId          String        @db.Uuid
  paymentId         String?       @db.Uuid
  status            DisputeStatus @default(open)
  reason            String
  description       String?
  resolution        String?
  refundAmountCents Int?
  resolvedById      String?       @db.Uuid
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId])
  @@index([rentalId, status])
}

model Claim {
  id                String      @id @default(uuid()) @db.Uuid
  customerId        String      @db.Uuid
  customer          Customer    @relation(fields: [customerId], references: [id])
  rentalId          String      @db.Uuid
  incidentId        String?     @db.Uuid
  insurancePolicyId String?     @db.Uuid
  providerClaimId   String?
  type              ClaimType
  status            ClaimStatus @default(submitted)
  description       String
  occurredAt        DateTime
  lat               Float?
  lng               Float?
  photoObjectKeys   String[]
  statusNote        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([customerId])
}

model SupportConversation {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @db.Uuid
  customer        Customer           @relation(fields: [customerId], references: [id])
  rentalId        String?            @db.Uuid
  subject         String
  status          ConversationStatus @default(open)
  lastMessageAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  messages SupportMessage[]

  @@index([customerId])
}

model SupportMessage {
  id                   String              @id @default(uuid()) @db.Uuid
  conversationId       String              @db.Uuid
  conversation         SupportConversation @relation(fields: [conversationId], references: [id])
  authorType           MessageAuthorType
  authorId             String?             @db.Uuid
  authorName           String?
  body                 String
  attachmentObjectKeys String[]
  createdAt            DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model MaintenanceTask {
  id           String            @id @default(uuid()) @db.Uuid
  vehicleId    String            @db.Uuid
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id])
  kind         MaintenanceKind
  title        String
  description  String?
  status       MaintenanceStatus @default(scheduled)
  scheduledFor DateTime?
  completedAt  DateTime?
  notes        String?
  createdById  String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([vehicleId])
  @@index([status])
}

model FieldTask {
  id                String          @id @default(uuid()) @db.Uuid
  type              FieldTaskType
  status            FieldTaskStatus @default(open)
  priority          TaskPriority
  vehicleId         String          @db.Uuid
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])
  targetLat         Float?
  targetLng         Float?
  assigneeId        String?         @db.Uuid
  notes             String?
  dueAt             DateTime?
  maintenanceTaskId String?         @db.Uuid
  createdById       String?         @db.Uuid
  completionNotes   String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  inspections   Inspection[]
  batterySwaps  BatterySwap[]

  @@index([status, priority])
  @@index([assigneeId])
}

model Inspection {
  id                String    @id @default(uuid()) @db.Uuid
  fieldTaskId       String    @db.Uuid
  fieldTask         FieldTask @relation(fields: [fieldTaskId], references: [id])
  vehicleId         String    @db.Uuid
  inspectorId       String    @db.Uuid
  /// { brakes, tires, lights, bell, speedLimiter }
  checklist         Json
  photoObjectKeys   String[]
  notes             String?
  passed            Boolean
  maintenanceTaskId String?   @db.Uuid
  alertId           String?   @db.Uuid
  idempotencyKey    String?   @unique
  recordedAt        DateTime
  createdAt         DateTime  @default(now())
}

model BatterySwap {
  id                     String    @id @default(uuid()) @db.Uuid
  fieldTaskId            String    @db.Uuid
  fieldTask              FieldTask @relation(fields: [fieldTaskId], references: [id])
  vehicleId              String    @db.Uuid
  operatorId             String    @db.Uuid
  removedBatterySerial   String
  installedBatterySerial String
  installedBatteryPct    Int?
  idempotencyKey         String?   @unique
  recordedAt             DateTime
  createdAt              DateTime  @default(now())
}

// ───────────── transversal ─────────────

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  key         String
  requestHash String
  statusCode  Int?
  response    Json?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

// ───────────── Task 5 (pagamentos, caução e seguro) — só modelos novos ─────────────

/// Webhook já processado (deduplicação por id do evento do provedor).
model ProcessedWebhook {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  type        String
  dataId      String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Referência a entidades no gateway: cliente (`customer`) e assinatura (`subscription`).
model PaymentProviderRef {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, provider])
  @@index([provider, providerId])
}

/// Repasse do prêmio à seguradora (um por apólice).
model InsuranceRemittance {
  id          String   @id @default(uuid()) @db.Uuid
  policyId    String   @unique @db.Uuid
  rentalId    String?  @db.Uuid
  insurer     String
  amountCents Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Recibo em PDF (bucket de relatórios) por pagamento.
model PaymentReceipt {
  paymentId String   @id @db.Uuid
  rentalId  String?  @db.Uuid
  bucket    String
  objectKey String
  createdAt DateTime @default(now())
}

/// NFS-e emitida por pagamento (via `InvoiceIssuer`).
model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @db.Uuid
  issuer      String
  number      String
  status      String
  amountCents Int
  issuedAt    DateTime @default(now())
}

/// Progresso da liquidação de um aluguel (fix round 1): plano decidido uma vez, passos concluídos, tentativas e lease
/// (dono + validade) para que só um executor por vez fale com o gateway.
model SettlementProgress {
  paymentId   String    @id @db.Uuid
  plan        String
  depositId   String?   @db.Uuid
  steps       Json      @default("{}")
  attempts    Int       @default(0)
  lastFailure String?
  /// Execuções que terminaram em erro/resultado ambíguo do gateway (fix round 2); no limite, a liquidação é estacionada.
  errorRuns   Int       @default(0)
  parkedAt    DateTime?
  parkedReason String?
  /// Liquidação concluída (Payment saiu de `pending`); o job de retomada só lê registros sem `finishedAt` e sem `parkedAt` (fix round 4).
  finishedAt  DateTime?
  leaseOwner  String?
  leaseUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@index([parkedAt, finishedAt, updatedAt])
}

/// Pedido de liberação de caução ainda não confirmado pelo gateway (retentado por job).
model DepositRelease {
  depositId   String    @id @db.Uuid
  reason      String
  attempts    Int       @default(0)
  lastError   String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([confirmedAt])
}

/// Valor efetivamente capturado de uma pré-autorização (teto de estorno do pagamento da caução).
model PaymentCapture {
  paymentId     String   @id @db.Uuid
  capturedCents Int
  createdAt     DateTime @default(now())
}

/// Pedido de estorno (fix round 2): reserva gravada junto com o claim do Payment; resultado do gateway reconciliado por job.
/// status: claimed (gateway ainda não chamado) | pending (resultado desconhecido) | succeeded | rejected | needs_review
model PaymentRefund {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @db.Uuid
  idempotencyKey    String   @unique
  amountCents       Int
  prevStatus        String
  prevRefundedCents Int
  newStatus         String
  newRefundedCents  Int
  status            String
  attempts          Int      @default(0)
  providerRefundId  String?
  lastError         String?
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([paymentId])
}

/// QA-21 (fix round 1): início de aluguel em andamento (moto reivindicada, desbloqueio pedido, aluguel ainda não criado).
/// Apagado quando o aluguel é criado ou compensado; o job de varredura compensa os que sobraram (processo morreu no meio).
model RentalStart {
  rentalId       String        @id @db.Uuid
  vehicleId      String        @db.Uuid
  customerId     String        @db.Uuid
  depositId      String?       @db.Uuid
  policyId       String?       @db.Uuid
  previousStatus VehicleStatus
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([customerId])
}

/// QA-07 (fix round 1): exclusão da identidade no pool de clientes pendente (falhou na hora). Guarda o `sub` só até o
/// Cognito confirmar a exclusão; o job de retentativa apaga a linha no sucesso.
model CustomerIdentityDeletion {
  customerId String   @id @db.Uuid
  sub        String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([attempts])
}
