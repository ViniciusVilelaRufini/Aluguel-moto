/// Catálogo de modelos ("Escolha sua moto"): categoria, foto (bucket de catálogo), preço por minuto e intervalo de revisão.
model VehicleModel {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique
  slug                 String   @unique
  categoryLabel        String
  description          String?
  photoObjectKey       String?
  pricePerMinuteCents  Int
  unlockFeeCents       Int?
  serviceIntervalKm    Int      @default(1000)
  serviceIntervalHours Int      @default(100)
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  vehicles Vehicle[]
}

/// Estação de troca de bateria (mapa do cliente e do operador).
model SwapStation {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  address            String
  lat                Float
  lng                Float
  availableBatteries Int      @default(0)
  totalSlots         Int      @default(0)
  openingHours       String
  open24h            Boolean  @default(false)
  active             Boolean  @default(true)
  /// Conteúdo do QR fixo da estação (`vst1.<id>.<hmac>`, assinado com `STATION_QR_SECRET`; sem dado pessoal). Nulo = QR
  /// ainda não emitido (o seed emite para todas). A API confere a assinatura **e** a igualdade com este valor.
  stationCode        String?  @unique
  /// *Thing* do armário no IoT Core (`station-<uuid>`, Task 12 das lacunas). Nulo = `station-{id}` (convenção do
  /// provisionamento); o painel pode apontar a estação para o armário provisionado com outro uuid.
  thingName          String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  swaps StationSwap[]
}

/// Troca de bateria feita pelo cliente numa estação (QR). Escrito à mão na migração: uma troca aberta por aluguel
/// (`StationSwap_one_open_per_rental`). LGPD: a posição do celular só é usada na validação; guarda-se a distância.
model StationSwap {
  id             String                @id @default(uuid()) @db.Uuid
  stationId      String                @db.Uuid
  station        SwapStation           @relation(fields: [stationId], references: [id])
  rentalId       String                @db.Uuid
  customerId     String                @db.Uuid
  vehicleId      String                @db.Uuid
  status         StationSwapStatus     @default(opening_slot)
  endReason      StationSwapEndReason?
  slotNumber     Int?
  /// Taxa congelada na criação (0 nos planos diário/semanal/mensal); cobrada no fechamento do aluguel (`battery_swap_fee`).
  feeCents       Int                   @default(0)
  /// Distância (m) do celular até a estação na validação.
  distanceM      Int
  returnedSerial String?
  returnedPct    Int?
  releasedSerial String?
  /// Prazo da etapa atual (3 min por etapa); vencido → o job cancela/falha a troca.
  expiresAt      DateTime
  /// Lacunas T5: `slot_closed` recebido sem devolução; o cancelamento espera alguns segundos por um `battery_returned` atrasado.
  slotClosedAt   DateTime?
  idempotencyKey String?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([stationId, createdAt])
  @@index([rentalId, status])
  @@index([status, expiresAt])
}

/// Cupom salvo na conta do cliente.
model CustomerCoupon {
  id         String               @id @default(uuid()) @db.Uuid
  customerId String               @db.Uuid
  couponId   String               @db.Uuid
  coupon     Coupon               @relation(fields: [couponId], references: [id])
  source     CustomerCouponSource @default(manual)
  createdAt  DateTime             @default(now())

  @@unique([customerId, couponId])
}

/// Indicação: um indicado por conta; recompensa do indicado na hora e de quem indicou na primeira corrida terminada.
model Referral {
  id                    String               @id @default(uuid()) @db.Uuid
  referrerId            String               @db.Uuid
  refereeId             String               @unique @db.Uuid
  code                  String
  status                ReferralRewardStatus @default(pending)
  referrerRewardCents   Int
  refereeRewardCents    Int
  refereeWalletEntryId  String?              @db.Uuid
  referrerWalletEntryId String?              @db.Uuid
  /// Fix round 1 (I4): HMAC do CPF do indicado e de quem indicou.
  refereeCpfHash        String?
  referrerCpfHash       String?
  createdAt             DateTime             @default(now())
  grantedAt             DateTime?

  @@index([referrerId, createdAt])
  @@index([refereeCpfHash])
}

// ───────────── retirada em galpão (docs/decisoes.md, 2026-10-22) ─────────────

model Depot {
  id                     String   @id @default(uuid()) @db.Uuid
  /// Único: o seed faz upsert pelo nome.
  name                   String   @unique
  address                String
  /// Bairro mostrado no cartão da home.
  district               String?
  lat                    Float
  lng                    Float
  timezone               String   @default("America/Sao_Paulo")
  /// [{ weekday 0–6 (0 = domingo), opensAt "HH:MM", closesAt "HH:MM" }]; dia ausente = fechado.
  openingHours           Json
  pickupNowWindowMinutes Int      @default(120)
  maxScheduleDays        Int      @default(7)
  scheduledGraceMinutes  Int      @default(30)
  swapStationId          String?  @db.Uuid
  /// Mínimo de baterias `charged`; abaixo dele abre `battery_stock_low`. Nulo ou 0 = sem alerta.
  minChargedBatteries    Int?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vehicles     Vehicle[]
  reservations Reservation[]
  handovers    Handover[]
  batteries    Battery[]

  @@index([active])
}

/// Entrega no galpão: saída (`pickup`, com aceite do cliente) ou chegada (`return_depot`, encerra o aluguel).
/// Escritos à mão nas migrações: uma saída pendente ou aceita por reserva (`Handover_one_open_pickup_per_reservation`;
/// disputada/cancelada libera refazer), uma chegada não cancelada por aluguel (`Handover_one_open_return_per_rental`)
/// e `Handover_type_reference` (`pickup` exige `reservationId`; `return_depot` exige `rentalId`).
model Handover {
  id            String         @id @default(uuid()) @db.Uuid
  type          HandoverType
  status        HandoverStatus @default(pending_customer)
  depotId       String         @db.Uuid
  depot         Depot          @relation(fields: [depotId], references: [id])
  reservationId String?        @db.Uuid
  reservation   Reservation?   @relation(fields: [reservationId], references: [id])
  /// Aluguel criado no aceite (`pickup`) ou que chega (`return_depot`); sem FK, como `Dispute.rentalId`.
  rentalId      String?        @db.Uuid
  vehicleId     String         @db.Uuid
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  /// StaffUser.id do operador (o cliente vê só o primeiro nome).
  operatorId    String         @db.Uuid
  /// [{ code, ok, note? }]
  checklist     Json
  /// Chaves S3 com prefixo `handovers/`.
  photoKeys     String[]
  batteryPct    Int
  batterySerial String?
  disputeReason String?
  /// Slug do último erro do aceite (ex.: `payment-declined`); limpo quando o aceite dá certo.
  lastError     String?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([depotId, status])
  @@index([reservationId])
  @@index([rentalId])
  @@index([vehicleId])
}
