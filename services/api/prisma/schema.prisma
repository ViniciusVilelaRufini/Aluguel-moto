// ───────────── pessoas ─────────────

model Customer {
  id                        String         @id @default(uuid()) @db.Uuid
  cognitoSub                String         @unique
  email                     String
  name                      String?
  phone                     String?
  cpf                       String?        @unique
  birthDate                 DateTime?      @db.Date
  kycStatus                 KycStatus      @default(not_started)
  kycReason                 String?
  kycSubmittedAt            DateTime?
  kycReviewedAt             DateTime?
  kycDocumentType           DocumentType?
  kycDocumentFrontKey       String?
  kycDocumentBackKey        String?
  kycSelfieKey              String?
  status                    CustomerStatus @default(active)
  delinquent                Boolean        @default(false)
  blockedReason             String?
  blockedAt                 DateTime?
  emergencyContactName      String?
  emergencyContactPhone     String?
  termsVersion              String?
  termsAccepted             Boolean        @default(false)
  termsAcceptedAt           DateTime?
  locationConsent           Boolean        @default(false)
  locationConsentUpdatedAt  DateTime?
  marketingConsent          Boolean        @default(false)
  consentsUpdatedAt         DateTime?
  /// Chave Pix para estornos (contrato v2), normalizada pelo tipo.
  pixRefundKeyType          PixKeyType?
  pixRefundKey              String?
  /// Código de indicação (gerado no primeiro GET /me/referral).
  referralCode              String?        @unique
  /// Fix round 1 (I4): HMAC-SHA256 do CPF (FRAUD_HASH_SECRET), retido após a exclusão LGPD para prevenção a fraude.
  cpfHash                   String?
  deletedAt                 DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  reservations  Reservation[]
  rentals       Rental[]
  payments      Payment[]
  deposits      Deposit[]
  cards         PaymentCard[]
  subscriptions Subscription[]
  walletEntries WalletEntry[]
  topUps        TopUp[]
  policies      InsurancePolicy[]
  incidents     Incident[]
  disputes      Dispute[]
  claims        Claim[]
  conversations SupportConversation[]

  @@index([kycStatus])
  @@index([cpfHash])
  @@index([status])
}

model StaffUser {
  id          String       @id @default(uuid()) @db.Uuid
  cognitoSub  String?      @unique
  email       String       @unique
  name        String
  groups      StaffGroup[]
  active      Boolean      @default(true)
  mfaEnabled  Boolean      @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  fcmToken   String         @unique
  platform   DevicePlatform
  appVersion String?
  ownerType  ActorType
  ownerId    String         @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([ownerId])
}

model RestrictionEntry {
  id          String   @id @default(uuid()) @db.Uuid
  cpf         String   @unique
  reason      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
}

// ───────────── frota ─────────────

model Vehicle {
  id                    String         @id @default(uuid()) @db.Uuid
  code                  String         @unique
  qrCode                String?
  model                 String
  thingName             String         @unique
  status                VehicleStatus  @default(free)
  statusBeforeOffline   VehicleStatus?
  lat                   Float          @default(0)
  lng                   Float          @default(0)
  batteryPct            Int            @default(100)
  speedLimitKmh         Int            @default(32)
  speedKmh              Float?
  online                Boolean        @default(true)
  locked                Boolean        @default(true)
  ignition              Boolean        @default(false)
  signal                Int?
  stolenMode            Boolean        @default(false)
  firmwareVersion       String?
  lastSeenAt            DateTime?
  batterySerial         String?
  /// Contrato v2: catálogo, endereço em cache e manutenção preventiva por km/horas.
  vehicleModelId        String?        @db.Uuid
  vehicleModel          VehicleModel?  @relation(fields: [vehicleModelId], references: [id])
  addressLabel          String?
  addressLat            Float?
  addressLng            Float?
  addressUpdatedAt      DateTime?
  odometerKm            Float          @default(0)
  usageHours            Float          @default(0)
  lastServiceAt         DateTime?
  lastServiceOdometerKm Float          @default(0)
  lastServiceUsageHours Float          @default(0)
  /// Retirada em galpão: galpão de origem/atual. Disponível no galpão = `free` com `depotId`; moto com `depotId` só sai
  /// pela entrega (nunca pelo aluguel/reserva de rua — regra no código).
  depotId               String?        @db.Uuid
  depot                 Depot?         @relation(fields: [depotId], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tracker      Tracker?
  reservations Reservation[]
  rentals      Rental[]
  commands     VehicleCommand[]
  fieldTasks   FieldTask[]
  maintenance  MaintenanceTask[]
  handovers    Handover[]

  @@index([status])
  @@index([depotId, status])
}

model Tracker {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String?  @unique @db.Uuid
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  thingName       String   @unique
  imei            String?
  firmwareVersion String?
  certificateArn  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Battery {
  id         String        @id @default(uuid()) @db.Uuid
  serial     String        @unique
  chargePct  Int           @default(100)
  vehicleId  String?       @db.Uuid
  /// Contrato v2: ciclos (+1 a cada instalação), onde está e quem leva na van.
  cycleCount Int           @default(0)
  status     BatteryStatus @default(charging)
  holderId   String?       @db.Uuid
  stationId  String?       @db.Uuid
  /// Galpão onde a bateria está quando `charging`, `charged` ou `defective` (nulo nas linhas antigas).
  depotId    String?       @db.Uuid
  depot      Depot?        @relation(fields: [depotId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  movements BatteryMovement[]

  @@index([vehicleId])
  @@index([holderId, status])
  @@index([depotId, status])
}

/// Histórico de movimentação: uma linha por mudança de status (ou de lugar) da bateria. `fromStatus` nulo = cadastro.
/// `actorId`: staff (ou o cliente, na troca por QR); sem FK porque pode ser de qualquer um dos dois.
model BatteryMovement {
  id         String         @id @default(uuid()) @db.Uuid
  batteryId  String         @db.Uuid
  battery    Battery        @relation(fields: [batteryId], references: [id], onDelete: Cascade)
  fromStatus BatteryStatus?
  toStatus   BatteryStatus
  depotId    String?        @db.Uuid
  stationId  String?        @db.Uuid
  vehicleId  String?        @db.Uuid
  actorId    String         @db.Uuid
  reason     String?
  at         DateTime       @default(now())

  @@index([batteryId, at])
}

/// Cerca. `geom` (PostGIS) é a fonte para ST_Contains; `geometry` guarda o GeoJSON devolvido pela API.
model Zone {
  id            String                                 @id @default(uuid()) @db.Uuid
  name          String
  type          ZoneType
  speedLimitKmh Int?
  geometry      Json
  geom          Unsupported("geometry(Polygon,4326)")?
  active        Boolean                                @default(true)
  deletedAt     DateTime?
  createdAt     DateTime                               @default(now())
  updatedAt     DateTime                               @updatedAt

  @@index([type, active])
  @@index([geom], map: "Zone_geom_gist", type: Gist)
}

model VehicleCommand {
  id              String               @id @default(uuid()) @db.Uuid
  vehicleId       String               @db.Uuid
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id])
  type            CommandType
  status          CommandStatus        @default(pending)
  statusReason    CommandStatusReason?
  reason          String
  requestedById   String?              @db.Uuid
  requestedByType ActorType            @default(staff)
  requestedByName String?
  /// { speedLimitKmh?, on?, rentalId?, fieldTaskId?, purpose? }
  payload         Json                 @default("{}")
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([vehicleId, createdAt])
  @@index([status])
}

/// Ponto de trajeto (LGPD): só durante aluguel; expira em 90 dias.
model TrackPoint {
  id         String   @id @default(uuid()) @db.Uuid
  rentalId   String?  @db.Uuid
  vehicleId  String   @db.Uuid
  lat        Float
  lng        Float
  speedKmh   Float    @default(0)
  recordedAt DateTime
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([rentalId, recordedAt])
  @@index([vehicleId, recordedAt])
}

// ───────────── preços ─────────────

model PricingPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  code                PlanCode
  name                String
  description         String?
  unit                PlanUnit
  unlockFeeCents      Int      @default(0)
  unitPriceCents      Int
  pausePerMinuteCents Int      @default(0)
  recurring           Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([code, active])
}

model Coupon {
  id                        String       @id @default(uuid()) @db.Uuid
  code                      String       @unique
  description               String?
  discountType              DiscountType
  percentOff                Int?
  amountOffCents            Int?
  planCodes                 PlanCode[]
  validFrom                 DateTime?
  validUntil                DateTime?
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?
  redemptions               Int          @default(0)
  active                    Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  redemptionsLog  CouponRedemption[]
  customerCoupons CustomerCoupon[]
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customerId String   @db.Uuid
  rentalId   String   @unique @db.Uuid
  /// Fix round 1 (I4): HMAC do CPF de quem usou (limite por cliente sobrevive à exclusão da conta).
  cpfHash    String?
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
  @@index([couponId, cpfHash])
}

model Fee {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  amountCents Int
  active      Boolean  @default(true)
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────── reserva e aluguel ─────────────

model Reservation {
  id             String             @id @default(uuid()) @db.Uuid
  customerId     String             @db.Uuid
  customer       Customer           @relation(fields: [customerId], references: [id])
  vehicleId      String             @db.Uuid
  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id])
  status         ReservationStatus  @default(active)
  depositId      String?            @db.Uuid
  expiresAt      DateTime
  endedAt        DateTime?
  /// Retirada em galpão (todos nulos na reserva de rua). Plano, seguro e cupom são aplicados no aceite da entrega.
  depotId        String?            @db.Uuid
  depot          Depot?             @relation(fields: [depotId], references: [id])
  pickupMode     PickupMode?
  pickupAt       DateTime?
  planCode       PlanCode?
  coverage       InsuranceCoverage?
  depositMethod  DepositMethod?
  cardId         String?            @db.Uuid
  couponCode     String?
  reminderSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  handovers Handover[]

  @@index([customerId, status])
  @@index([vehicleId, status])
  @@index([status, expiresAt])
  @@index([depotId, pickupAt])
}

model Rental {
  id                     String            @id @default(uuid()) @db.Uuid
  customerId             String            @db.Uuid
  customer               Customer          @relation(fields: [customerId], references: [id])
  vehicleId              String            @db.Uuid
  vehicle                Vehicle           @relation(fields: [vehicleId], references: [id])
  planCode               PlanCode
  coverage               InsuranceCoverage
  status                 RentalStatus      @default(active)
  startedAt              DateTime          @default(now())
  pausedAt               DateTime?
  pausedSecondsAcc       Int               @default(0)
  endRequestedAt         DateTime?
  endLastAttemptAt       DateTime?
  endAttempts            Int               @default(0)
  endedAt                DateTime?
  /// Preço congelado no início: { unit, unlockFeeCents, unitPriceCents, pausePerMinuteCents, insurancePremiumCents, subscriptionCovered, coupon? }
  priceSnapshot          Json
  costCents              Int               @default(0)
  breakdown              Json?
  couponCode             String?
  depositId              String            @db.Uuid
  insurancePolicyId      String?           @db.Uuid
  paymentId              String?           @db.Uuid
  endZoneId              String?           @db.Uuid
  returnPhotoUploadKey   String?
  returnPhotoObjectKey   String?
  forceEndReason         String?
  forcedEndById          String?           @db.Uuid
  rating                 Int?
  ratingComment          String?
  speedLimitKmh          Int?
  startLat               Float?
  startLng               Float?
  wellbeingCheckDueAt    DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  events RentalEvent[]

  @@index([customerId, startedAt])
  @@index([vehicleId, startedAt])
  @@index([status])
}

model RentalEvent {
  id        String          @id @default(uuid()) @db.Uuid
  rentalId  String          @db.Uuid
  rental    Rental          @relation(fields: [rentalId], references: [id])
  type      RentalEventType
  at        DateTime        @default(now())
  actorType ActorType
  actorId   String?         @db.Uuid
  message   String?
  data      Json?

  @@index([rentalId, at])
}

model LocationShare {
  id        String   @id @default(uuid()) @db.Uuid
  rentalId  String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ───────────── pagamentos (Task 5 implementa a lógica real) ─────────────

model PaymentCard {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id])
  providerCardId  String
  brand           String
  last4           String
  expMonth        Int
  expYear         Int
  isDefault       Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([customerId])
}

model Deposit {
  id                String        @id @default(uuid()) @db.Uuid
  rentalId          String?       @db.Uuid
  customerId        String        @db.Uuid
  customer          Customer      @relation(fields: [customerId], references: [id])
  method            DepositMethod
  status            DepositStatus
  amountCents       Int
  capturedCents     Int?
  cardId            String?       @db.Uuid
  idempotencyKey    String?       @unique
  providerReference String?
  /// PixCharge { chargeId, qrCodeBase64, copyPaste, expiresAt }
  pix               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId, status])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @db.Uuid
  customer          Customer      @relation(fields: [customerId], references: [id])
  rentalId          String?       @db.Uuid
  depositId         String?       @db.Uuid
  subscriptionId    String?       @db.Uuid
  kind              PaymentKind
  method            PaymentMethod
  status            PaymentStatus
  amountCents       Int
  refundedCents     Int           @default(0)
  /// Task 16 (R2-01): parte do `amountCents` (bruto) paga com a carteira no fechamento; o restante é cobrado no gateway/caução.
  walletCents       Int           @default(0)
  cardLast4         String?
  failureReason     String?
  providerPaymentId String?
  receiptUrl        String?
  idempotencyKey    String?       @unique
  /// Dívida (pagamento `failed` de aluguel/assinatura) quitada: pelo cliente (`payment`) ou pelo financeiro (`manual`).
  debtSettledAt     DateTime?
  debtSettlement    DebtSettlementKind?
  /// Só em `debt_settlement`: o pagamento cuja dívida esta cobrança quita (índice parcial `Payment_one_pending_debt_settlement`: uma pendente por dívida, escrito à mão).
  settlesPaymentId  String?       @db.Uuid
  /// Só em `debt_settlement` por Pix: PixCharge { chargeId, qrCodeBase64, copyPaste, expiresAt } (reaproveitado enquanto vale).
  pix               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([rentalId])
  @@index([status])
  @@index([settlesPaymentId])
}

/// LGPD: exclusão do cliente (e cartões) no gateway depois da exclusão da conta, com retentativa (job a cada 5 min).
/// A linha some quando o gateway confirma; guarda só ids do gateway (nunca dados do cartão).
model ProviderCustomerDeletion {
  customerId         String   @id @db.Uuid
  provider           String
  providerCustomerId String
  providerCardIds    String[]
  attempts           Int      @default(0)
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  customerId         String             @db.Uuid
  customer           Customer           @relation(fields: [customerId], references: [id])
  planCode           PlanCode
  status             SubscriptionStatus
  cardId             String?            @db.Uuid
  priceCents         Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  /// Contrato v2: pausa (limites em subscription-rules.ts) e moto fixa.
  pausedAt           DateTime?
  pauseEndsAt        DateTime?
  pausesUsedInPeriod Int                @default(0)
  assignedVehicleId  String?            @db.Uuid
  /// Fix round 1 (M9): quando a moto fixa foi definida (espera entre trocas pelo cliente).
  assignedVehicleAt  DateTime?
  /// Fix round 2: cancelamento no gateway ainda não confirmado (assinatura expirada ou conta excluída). O job refaz até o
  /// gateway aceitar; enquanto isso a recorrência pode cobrar e a cobrança tardia é estornada.
  gatewayCancelPendingAt DateTime?
  gatewayCancelAttempts  Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId, status])
  @@index([gatewayCancelPendingAt])
}

