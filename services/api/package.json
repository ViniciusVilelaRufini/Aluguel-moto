{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API principal da Volti (NestJS + Prisma + PostGIS + Redis).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node scripts/start.mjs",
    "dev": "prisma generate && tsc -p tsconfig.build.json && node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:contract": "jest --config test/jest-contract.config.js --runInBand",
    "prisma": "prisma",
    "stations:qr": "tsx src/cli/issue-station-qr.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.709.0",
    "@aws-sdk/client-iot": "3.709.0",
    "@aws-sdk/client-iot-data-plane": "3.709.0",
    "@aws-sdk/client-location": "3.709.0",
    "@aws-sdk/client-s3": "3.709.0",
    "@aws-sdk/client-sqs": "3.709.0",
    "@aws-sdk/s3-request-presigner": "3.709.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/event-emitter": "2.1.1",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "5.22.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jose": "5.9.6",
    "mqtt": "5.10.1",
    "pdfkit": "0.15.2",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@nestjs/testing": "10.4.22",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.13.9",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "jest-mock-extended": "3.0.7",
    "jest-openapi": "0.14.2",
    "js-yaml": "4.1.0",
    "nock": "14.0.1",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.18.1"
  }
}
